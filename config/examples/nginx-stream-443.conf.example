# nginx stream SNI router for host :443 (operator-managed — NOT deployed by this kit).
#
# Profile: MTPROXY_MODE=sni — sites + MTProxy + optional VLESS on one public :443.
# See docs/MTPROXY.md § SNI migration and docs/PORT-443.md.
#
# Install (example):
#   sudo cp config/examples/nginx-stream-443.conf.example /etc/nginx/stream.d/vpn-bridge-443.conf
#   # Edit map hostnames from .data/.env (MTPROXY_SNI, REALITY_INBOUND_SERVER_NAME, site SNIs)
#   sudo nginx -t && sudo systemctl reload nginx
#
# Sites: move TLS vhosts from listen 443 → listen 127.0.0.1:8080 ssl (same certs).
# Certbot: use DNS-01 when sites are behind stream (HTTP-01 on :443 unavailable).

map $ssl_preread_server_name $upstream_443 {
    # MTProxy Fake-TLS SNI — MTPROXY_SNI in .data/.env
    # EE domain www.google.com → secret tail is often google.com (not www)
    google.com              127.0.0.1:8444;
    www.google.com          127.0.0.1:8444;

    # VLESS REALITY inbound SNI — REALITY_INBOUND_SERVER_NAME in .data/.env
    apple.com               127.0.0.1:8443;

    # Site SNIs (repeat per domain) or use default for catch-all:
    # www.site1.example     127.0.0.1:8080;
    # www.site2.example     127.0.0.1:8080;

    default                 127.0.0.1:8080;
}

server {
    listen 443 reuseport;
    listen [::]:443 reuseport;
    ssl_preread on;
    proxy_pass $upstream_443;
    proxy_connect_timeout 5s;
    proxy_timeout 1h;
}
