# AmneziaWG client config example (no real keys)
# Generated by: scripts/clients/awg/add.sh <name>

[Interface]
PrivateKey = YOUR_CLIENT_PRIVATE_KEY
Address = 10.8.0.X/32
DNS = 10.8.0.1
Jc = 1
Jmin = 22
Jmax = 33
S1 = 44
S2 = 55
S3 = 77
S4 = 8
H1 = 22222222-33333333
H2 = 444444444-555555555
H3 = 1111111111-2222222222
H4 = 2222222222-1111111111

[Peer]
PublicKey = YOUR_SERVER_PUBLIC_KEY
Endpoint = YOUR_IN_SERVER_IP:AWG_PORT
AllowedIPs = 0.0.0.0/0, ::/0
PersistentKeepalive = 25
