# Amnezia Reality Kit — Environment Configuration
# Canonical template — make create-data copies this file to .data/.env
# Root .env.example is a mirror; edit here first, then sync to repo root if needed.
# Copy to .data/.env (never commit). Regenerate: make create-data | make build
#
# PORT LEGEND (what can conflict on the HOST):
#   HOST PUBLISH  → ss shows 0.0.0.0:PORT (or 127.0.0.1) — check with make check 7
#   OUT EXIT      → IN connects OUT; nothing listens on IN for these ports
#   INTERNAL      → Docker / container / tunnel only — not host publish

################################################################################
#
#  ENDPOINT FORMAT (IN_INGRESS, OUT_EXIT, OUT_EXPECTED_EGRESS, IN_BRIDGE_SOURCE):
#    FAMILY; ADDRESS     FAMILY = 4 (IPv4) | 6 (IPv6)
#  On disk use single-quoted tuples (I1/I2) — unquoted "4; ip" breaks: source .env
#  Examples:
#    '4; 198.51.100.10'
#    '6; 2606:4700:0000:0000:0000:0000:0000:0001'
#
################################################################################

################################################################################
#
#  HOST PUBLISH (IN) — clients connect here
#
#  AmneziaWG  →  IN_INGRESS host :AWG_PORT (UDP)
#  VLESS      →  IN_INGRESS host :XRAY_INBOUND_PORT (TCP, if enabled)
#  MTProxy    →  IN_INGRESS host :MTPROXY_HOST_PORT (TCP, if ENABLE_MTPROXY=1)
#
################################################################################

IN_INGRESS='4; 198.51.100.10'
# IN_INGRESS_6=6; 2606:4700::10     # optional dual-stack ingress

IN_BRIDGE_SOURCE=auto
# IN_BRIDGE_SOURCE=4; 198.51.100.10  # optional: pin source IP seen by OUT

# AmneziaWG client → this host (always on when stack is up)
AWG_PORT=58285                       # HOST UDP  0.0.0.0:58285 → container (see AWG_LISTEN_PORT)

# Direct VLESS client → this host (optional; set 0 to free host :443 for a website)
ENABLE_XRAY_INBOUND=1                # 1=publish inbound  0=AWG bridge only
XRAY_INBOUND_PORT=443                # HOST TCP  0.0.0.0:PORT → vpn-xray  (try 8443 if :443=site)

# Inbound REALITY keys (required when ENABLE_XRAY_INBOUND=1)
REALITY_PRIVATE_KEY=YOUR_REALITY_PRIVATE_KEY_HERE
REALITY_PUBLIC_KEY=YOUR_REALITY_PUBLIC_KEY_HERE
REALITY_SHORT_ID=YOUR_SHORT_ID_HERE
VLESS_UUID=YOUR_UUID_HERE
REALITY_DEST=cloudflare.com:443      # inbound mask (dest), not OUT server
REALITY_INBOUND_SERVER_NAME=apple.com

# MTProxy (Teleproxy) — optional Telegram ingress (see docs/MTPROXY.md)
ENABLE_MTPROXY=0
MTPROXY_MODE=standalone
TELEPROXY_VERSION=4.12.0
MTPROXY_SECRET=
MTPROXY_EE_DOMAIN=
MTPROXY_SNI=
MTPROXY_CONTAINER_PORT=443
MTPROXY_HOST_PORT=8444
MTPROXY_PUBLISH=0.0.0.0
MTPROXY_EXTERNAL_PORT=
MTPROXY_STATS_PORT=8888
MTPROXY_DIRECT_MODE=true
MTPROXY_WORKERS=1
MTPROXY_DC_PROBE_INTERVAL=30
MTPROXY_MEM_LIMIT=128m

################################################################################
#
#  OUT EXIT (remote) — IN xray REALITY outbound (destination on OUT)
#
#  AWG path: client → IN → SOCKS → OUT_EXIT → OUT REALITY
#
################################################################################

OUT_EXIT='6; 2606:4700:0000:0000:0000:0000:0000:0001'
OUT_REALITY_PORT=443                 # Port on OUT server (usually 443)

# Expected public IP after exit on OUT — for make check / curl verification only (not in xray)
OUT_EXPECTED_EGRESS='4; 198.51.100.20'

OUT_VLESS_UUID=YOUR_OUT_VLESS_UUID_HERE
OUT_REALITY_PUBLIC_KEY=YOUR_OUT_REALITY_PUBLIC_KEY_HERE
OUT_REALITY_SHORT_ID=YOUR_OUT_SHORT_ID_HERE
OUT_REALITY_SERVER_NAME=dl.google.com

################################################################################
#
#  INTERNAL — not host publish
#
#  Docker bridge, container netns, AWG tunnel, ipt2socks redirects.
#  Will NOT show as public 0.0.0.0 listeners (except loopback SOCKS below).
#
################################################################################

# AWG inside container (docker maps AWG_PORT → this)
AWG_LISTEN_PORT=51820

# SOCKS: containers use XRAY_IP:1080; host bind is loopback only
SOCKS_PORT=1080                      # 127.0.0.1:1080 on host; ${XRAY_IP}:1080 in docker
SOCKS_USER=vpn-user
SOCKS_PASSWORD=YOUR_STRONG_PASSWORD_HERE

# AWG tunnel (client IPs 10.8.0.0/24 — not host ports)
AWG_TUNNEL_IPV4=10.8.0.1/24
AWG_TUNNEL_IPV6=fd86:ea04:1115::1/64
AWG_TUNNEL_SUBNET_IPV4=10.8.0.0/24
AWG_TUNNEL_SUBNET_IPV6=fd86:ea04:1115::/64
AWG_TUNNEL_GATEWAY_IPV4=10.8.0.1

# iptables REDIRECT → ipt2socks (inside containers — not host publish)
AWG_IPT2SOCKS_PORT=12345
AWG_IPT2SOCKS_PORT_IPV6=12346
COREDNS_IPT2SOCKS_PORT=12347
# CoreDNS upstream (rendered into .data/build/Corefile — not host publish)
COREDNS_UPSTREAM=tls://1.1.1.1
COREDNS_UPSTREAM_TLS_SNI=cloudflare-dns.com
# UDP exit: iptables NFQUEUE → udp-relay → SOCKS → REALITY OUT (IPv4 only; IPv6 UDP not relayed)
# AWG_UDP_RELAY_PORT* — migration-only (awg-migrate-tproxy.sh removes legacy TPROXY rules on old port)
AWG_UDP_RELAY_PORT=12348
AWG_UDP_RELAY_PORT_IPV6=12349
AWG_NFQUEUE_NUM=100
AWG_UDP_RELAY_LOG_LEVEL=info

IPT2SOCKS_THREADS=2
IPT2SOCKS_NOFILE_LIMIT=8192
IPT2SOCKS_UDP_TIMEOUT=60

# Docker bridge "vpn" — single source of truth (SSOT)
#
# Set ONLY these two lines. Gateway and container IPs are derived on make build:
#   .1 gateway   .2 CoreDNS   .3 AmneziaWG   .4 Xray   .5 Teleproxy
#
# Do NOT add COREDNS_IP, AMNEZIAWG_IP, XRAY_IP, TELEPROXY_IP, or DOCKER_NETWORK_GATEWAY_IPV4
# unless you intentionally pin a custom address inside the subnet.
#
# Default 10.200.97.0/24 is off the usual 172.17–172.31 / 172.20.x ladder.
# On a shared host: pick any free /24, then make network-plan → make build → deploy-host → refresh-full.
DOCKER_NETWORK_SUBNET_IPV4=10.200.97.0/24
DOCKER_NETWORK_SUBNET_IPV6=fd87:172:20::/64

################################################################################
#
#  AMNEZIAWG SERVER & BUILD
#
################################################################################

AWG_SERVER_PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE
AWG_SERVER_PUBLIC_KEY=YOUR_PUBLIC_KEY_HERE
AWG_TOOLS_REF=YOUR_AWG_TOOLS_SHA_HERE
AMNEZIAWG_RELEASE=latest
XRAY_IMAGE=teddysun/xray:26.6.27
COREDNS_IMAGE=coredns:1.11.1

AWG_JC=1
AWG_JMIN=22
AWG_JMAX=33
AWG_S1=44
AWG_S2=55
AWG_S3=77
AWG_S4=8
AWG_H1=22222222-33333333
AWG_H2=444444444-555555555
AWG_H3=1111111111-2222222222
AWG_H4=2222222222-1111111111

################################################################################
#
#  PERFORMANCE & LOGGING
#
################################################################################

AMNEZIAWG_MEM_LIMIT=512m
COREDNS_MEM_LIMIT=256m
XRAY_MEM_LIMIT=256m
LOG_MAX_SIZE=5m
LOG_MAX_FILE=2

# SECURITY: chmod 600 .env | rotate keys periodically | never commit
